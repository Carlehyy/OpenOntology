ARG NGINX_BASE_IMAGE=nginx:1.27-alpine
# docker-compose.prod.yml 仍按契约传入 NODE_BASE_IMAGE；预构建形态不再消费它，
# 保留声明以避免 "build arg not consumed" 警告。
ARG NODE_BASE_IMAGE=node:22-alpine
FROM ${NGINX_BASE_IMAGE}

# 静态产物由 CI 在通过全部门禁后构建并随部署归档上传（见
# .github/workflows/deploy-nano-ontoprompt.yml 与 docs/operations/deployment.md），
# 服务器端不再重复执行 npm ci / vite build。本地构建本镜像前需先在 frontend/
# 下执行 npm ci && npm run build 生成 dist/。
COPY dist /usr/share/nginx/html
# conf.d 只加载 *.conf；locations.inc 供两个 server include，不单独生效
COPY nginx/default.conf nginx/ssl-443.conf nginx/locations.inc nginx/gzip.conf /etc/nginx/conf.d/
EXPOSE 80 443
