{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:feature-boundaries": "node scripts/check-feature-boundaries.mjs",
    "check:component-convergence": "node scripts/check-component-convergence.mjs",
    "check:color-tokens": "node scripts/check-color-tokens.mjs",
    "check:e2e-assertions": "node scripts/check-e2e-geometry-assertions.mjs",
    "test": "npm run test:unit && npm run test:e2e:mocked",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e:classification": "node scripts/check-e2e-classification.mjs",
    "test:e2e:mocked": "playwright test --config=playwright.mocked.config.ts",
    "test:e2e:stack": "playwright test --config=playwright.stack.config.ts",
    "test:e2e:external": "playwright test --config=playwright.external.config.ts"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.8",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@heroicons/react": "^2.2.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.100.10",
    "@types/cytoscape": "^3.21.9",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.0",
    "antd": "^6.6.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.33.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.16.0",
    "motion": "^13.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.160.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
