# 复制本文件为 config/generated/local/defaults.env 后填写本机凭据。
# defaults.env 只在尚未生成 config/generated/local/.env 时读取，并已被 Git 忽略。

# 平台与端口
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_HOST=127.0.0.1
LOCAL_FRONTEND_PORT=5173

# PostgreSQL
LOCAL_POSTGRES_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DATABASE=openontology
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=

# Redis 与 Celery
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_DATABASE=0
LOCAL_REDIS_USER=
LOCAL_REDIS_PASSWORD=

# NATS 消息队列（需以 -js 启用 JetStream）
NATS_URL=nats://127.0.0.1:4222

# 用户进程插件 runner：disabled 为安全默认值；生产环境必须部署独立
# rootless runner 后再切换为 nats。direct_dev 仅供本地协议测试。
SUPER_ASSISTANT_PROCESS_PLUGIN_RUNNER_MODE=disabled

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# Chromium CDP
STEWARD_BROWSER_CDP_URL=http://127.0.0.1:9222

# n8n
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30

# WeKnora 共享知识库（模型、知识库和 MCP 端点在原生 Web 配置）
WEKNORA_BASE_URL=http://127.0.0.1:18080
WEKNORA_WEB_URL=http://127.0.0.1:8089
WEKNORA_TIMEOUT_SECONDS=15

# Kaneo 任务看板（单用户独立账号在原生 HTTPS 页面管理，不保存 Kaneo 凭据）
KANEO_BASE_URL=http://127.0.0.1:18090
KANEO_WEB_URL=https://localhost:8445
KANEO_TIMEOUT_SECONDS=15

# Hindsight 长期记忆（可选 profile hindsight；密钥不写入本文件）
HINDSIGHT_BASE_URL=http://127.0.0.1:18888
# 可选：浏览器可访问且已受保护的管理地址；本地 UI 为 http://127.0.0.1:19999，留空表示未启用
HINDSIGHT_WEB_URL=
HINDSIGHT_TIMEOUT_SECONDS=2
