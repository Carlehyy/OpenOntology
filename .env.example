# 本地开发模板；生产第三方依赖当前由仓库受控的 deploy/production.dependencies.env
# 提供（受控临时例外，完整清单与迁移计划见 docs/operations/configuration.md）。
# 服务器首次部署会生成并持久化应用运行密钥；不要盲目轮换可能参与数据加密的密钥。
ENVIRONMENT=development
DATABASE_URL=postgresql://ontoprompt:ontoprompt@db:5432/ontoprompt
# Redis is always authenticated; the password is a local-development default.
# Production deployment replaces it with a generated server-side secret.
REDIS_PASSWORD=ontopromptredis123
REDIS_URL=redis://:ontopromptredis123@redis:6379/0
# 任务池读接口缓存（fail-open，可关闭；键落 db 1）
PIPELINE_TASK_CACHE_ENABLED=true
PIPELINE_TASK_LIST_CACHE_TTL_SECONDS=4
PIPELINE_TASK_STATS_CACHE_TTL_SECONDS=5
PIPELINE_TASK_OPTIONS_CACHE_TTL_SECONDS=30
# 本体详情页读接口缓存（fail-open，可关闭；键落 db 1）
# 覆盖：详情头 / 总览驾驶舱 / 待审批队列三个高频读接口；写路径自动失效。
ONTOLOGY_DETAIL_CACHE_ENABLED=true
ONTOLOGY_DETAIL_CACHE_TTL_SECONDS=60
ONTOLOGY_OVERVIEW_CACHE_TTL_SECONDS=20
ONTOLOGY_PENDING_CACHE_TTL_SECONDS=15
# ── 数据流水线读接口缓存（fail-open 加速层，键落 Redis db 1）──
# 关闭后全部直查；Redis 故障时自动降级直查，不影响主流程。
PIPELINE_READ_CACHE_ENABLED=true

SECRET_KEY=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=
# Fresh server bootstrap generates an independent Fernet ENCRYPTION_KEY. For an
# existing installation where this is empty, deploy-prod.sh first pins the old
# SECRET_KEY-derived key and only then rotates an example SECRET_KEY. Never
# replace both values manually: that makes persisted credentials unreadable.
# Empty CORS means same-origin only. Use comma-separated exact origins if needed.
CORS_ALLOWED_ORIGINS=
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=admin123
UPLOADS_DIR=/uploads
# 超级助手 Skill 默认保存到 <UPLOADS_DIR>/super-assistant/skills/<user>/<skill-id>。
SUPER_ASSISTANT_SKILL_ROOT=
# 公网 MCP 无需白名单；生产环境会自动拒绝环回、内网和链路本地地址。
# stdio 会在后端容器内启动进程，默认关闭；启用后仍需显式列出可执行 command。
SUPER_ASSISTANT_MCP_STDIO_ENABLED=false
SUPER_ASSISTANT_MCP_STDIO_ALLOWED_COMMANDS=
# 超级助手自我进化（对标 small-rust-hermes）：对话后自动做 micro 反思并产出
# 记忆/技能候选，低于置信度阈值或存在冲突的候选进入「待审批」人工确认。
# 反思任务经 NATS JetStream 派发（复用流水线 executor 进程消费）；未配置
# NATS_URL 时降级为 Web 进程内联执行——这是全平台唯一的无 NATS 降级例外，
# 流水线等其余派发保持 fail-closed。
SUPER_ASSISTANT_REFLECT_ENABLED=true
SUPER_ASSISTANT_REFLECT_INTERVAL=3
SUPER_ASSISTANT_AUTO_ACCEPT_MIN_CONFIDENCE=medium
# 工具权限：逗号分隔的工具名 glob（如 mcp__minio__delete_*,web_*），deny 优先。
SUPER_ASSISTANT_TOOL_ALLOW=
SUPER_ASSISTANT_TOOL_DENY=
# 联网工具：web_fetch 默认开启（SSRF 校验同 MCP）；web_search 需配置后端与密钥。
SUPER_ASSISTANT_WEB_FETCH_ENABLED=true
SUPER_ASSISTANT_WEB_SEARCH_BACKEND=
SUPER_ASSISTANT_WEB_SEARCH_TAVILY_API_KEY=
SUPER_ASSISTANT_WEB_SEARCH_BRAVE_API_KEY=
# Anthropic prompt caching（DeepSeek 等 anthropic 兼容端点不支持时需关闭）。
SUPER_ASSISTANT_PROMPT_CACHE_ENABLED=true
# 自主模式单条消息的最大工具迭代轮次（仅 agent_mode=true 时生效）。
SUPER_ASSISTANT_AGENT_MAX_ITERATIONS=50
# 超级助手：会话附件根目录，留空解析为 <UPLOADS_DIR>/super-assistant-sessions。
SUPER_ASSISTANT_WORKSPACE_ROOT=
# 超级助手：记忆宫殿（用户级文件库）根目录，留空解析为 <UPLOADS_DIR>/super-assistant-palace。
SUPER_ASSISTANT_PALACE_WORKSPACE_ROOT=
# 记忆宫殿配额与保护：单用户文件数 / 总存储(MB) / 在途抽取数 / 每小时抽取次数 / 单次 ZIP 导入文件数。
# 文件夹同步上线时上调文件数/存储/每小时默认值（原 500/2048/60）；在途与并发是抽取成本护栏。
SUPER_ASSISTANT_PALACE_MAX_FILES_PER_USER=2000
SUPER_ASSISTANT_PALACE_MAX_TOTAL_MB=10240
SUPER_ASSISTANT_PALACE_MAX_IN_FLIGHT=20
SUPER_ASSISTANT_PALACE_MAX_BUILDS_PER_HOUR=300
SUPER_ASSISTANT_PALACE_BATCH_MAX_FILES=100
# 记忆宫殿：图谱抽取并发（进程级）与每日聚类合并定时任务开关。
SUPER_ASSISTANT_PALACE_EXTRACT_CONCURRENCY=1
SUPER_ASSISTANT_PALACE_CONSOLIDATE_ENABLED=true
# 数据管家：会话文件根目录与独立浏览器 CDP 地址。CDP 是启动时必需
# 配置；只填写 HTTP(S) 服务根地址，不要附加 /json/version、查询参数或认证信息。
# 生产 Compose 固定使用随栈启动的 browser 服务。
STEWARD_WORKSPACE_ROOT=
STEWARD_BROWSER_CDP_URL=http://browser:9222
STEWARD_BROWSER_TIMEOUT_SECONDS=30
STEWARD_BROWSER_MAX_CAPTURES=300
STEWARD_BROWSER_FRAME_INTERVAL_MS=250
# WebSocket 被终端或代理拦截时，实时画面自动改走 HTTPS 轮询。
STEWARD_BROWSER_HTTP_LEASE_SECONDS=30
STEWARD_BROWSER_HTTP_FRAME_INTERVAL_MS=500
STEWARD_BROWSER_MAX_SESSIONS=8
STEWARD_BROWSER_MAX_SESSIONS_PER_USER=3
STEWARD_BROWSER_IDLE_TIMEOUT_SECONDS=900
STEWARD_BROWSER_REAPER_INTERVAL_SECONDS=30
STEWARD_BROWSER_ALLOW_PRIVATE_NETWORKS=true
STEWARD_PROXY_BASE_URL=http://backend:8000/api-hub/proxy
# n8n 是启动时必需的外部服务。复制本模板后必须填写一个可访问的 API
# 地址和 API Key；留空时后端会拒绝启动。
N8N_API_URL=
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30
# Python 脚本流水线的执行网关（Jupyter Kernel Gateway，可选）。Compose 部署
# 固定指向随栈启动的 python_kernel_gateway 服务；该服务以独立内核执行用户
# 脚本，不携带任何平台凭据环境变量。留空时脚本执行/保存返回明确错误。
PYTHON_KERNEL_GATEWAY_URL=http://python_kernel_gateway:8088
PYTHON_KERNEL_GATEWAY_AUTH_TOKEN=change-me-python-gateway-token
PYTHON_SCRIPT_TIMEOUT_SECONDS=120
# n8n 必须能访问此地址。生产部署脚本会在该值仍为默认值时，根据 HEALTH_URL
# 自动改成平台公网地址；显式配置的 HTTPS 地址永远不会被覆盖。
PIPELINE_FILE_GATEWAY_BASE_URL=http://backend:8000/api/v2/file-transfer
# 浏览器公网入口与 n8n 网关相互独立：APP 用于生成登录后继续下载的 Hash 深链，
# API 用于生成无需登录的匿名下载接口。两者都必须能从其他电脑的浏览器访问，
# 且只填写 HTTP(S) origin（不要包含路径、账号、查询参数或 # 片段）。
PIPELINE_FILE_PUBLIC_APP_BASE_URL=http://localhost:5173
PIPELINE_FILE_PUBLIC_API_BASE_URL=http://localhost:8000
# 可选：容器内 OfficeCLI 可执行文件的绝对路径。留空时核心会话文件空间仍可用，
# 但探索 Agent 不会获得 docx/xlsx/pptx 的结构化编辑工具。
EXPLORATION_OFFICECLI_PATH=
# 仅用于读取和迁移历史 local:// 对象；新写入始终要求 MinIO 可用。
# 生产 Compose 固定到共享持久卷 /uploads/object-storage。
STORAGE_LOCAL_DIR=storage
ALLOW_PUBLIC_REGISTRATION=true
PIPELINE_MAX_IN_MEMORY_ROWS=500000

# Production deploys require immutable @sha256 image references for every
# entry below. Floating tags are shown only as local/CI defaults.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5-community
MINIO_IMAGE=minio/minio:latest
BROWSER_IMAGE=chromedp/headless-shell:latest
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
# Set to 1 only after all image variables above use immutable @sha256 references.
# deploy-prod.sh reads this from the final merged .env unless the process explicitly
# exports STRICT_IMAGE_DIGESTS, which has higher priority.
STRICT_IMAGE_DIGESTS=0

# API Hub / 接口代理（已登记接口可调用任意 HTTP/HTTPS 目标）
API_HUB_DATA_DIR=
API_HUB_HTTP_TIMEOUT=30
API_HUB_MAX_RUNS_PER_INTERFACE=20
# 默认拒绝 loopback、链路本地、保留网段和 RFC1918 私网目标；仅对确需访问的
# 内网服务按精确主机名/IP 加白名单（逗号分隔），不要使用宽泛通配符。
API_HUB_OUTBOUND_BLOCK_PRIVATE_NETWORKS=true
API_HUB_OUTBOUND_TRUSTED_HOSTS=
# 接口重定向次数上限；每次重定向仍会校验目标必须是合法的 HTTP/HTTPS URL。
API_HUB_OUTBOUND_MAX_REDIRECTS=5
# 私有 CA 场景填写 CA bundle 路径；留空仍会校验系统信任链，不能关闭 TLS 校验。
API_HUB_TLS_CA_BUNDLE=
# 本体动作 Webhook 与 API Hub 共用上述出站安全策略；以下限制控制单次执行预算。
FORMAL_ACTION_WEBHOOK_TIMEOUT_SECONDS=15
FORMAL_ACTION_WEBHOOK_MAX_ATTEMPTS=2
FORMAL_ACTION_WEBHOOK_MAX_BODY_BYTES=1000000
# 令牌留空时对应 MCP 入口保持禁用（503），令牌只保存在服务端与调用方凭据库中。
API_HUB_MCP_TOKEN=
API_HUB_SYSTEM_MCP_TOKEN=
API_HUB_MCP_SERVER_NAME=api-hub
API_HUB_MCP_MAX_BODY_CHARS=20000
# 生产域名示例：api.example.com、https://api.example.com
API_HUB_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
API_HUB_MCP_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*
# 普通 HTTP 发布入口与调用方鉴权。公开接口形如 /proxy/<公开路径>，
# 调用方在 X-API-Hub-Key 中传入平台创建的独立密钥。
API_HUB_PROXY_PATH=/proxy
API_HUB_PROXY_KEY_HEADER=X-API-Hub-Key
API_HUB_PROXY_MAX_REQUEST_BYTES=10485760

# v2 — Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontoprompt123

# v2 — MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# 超级助手内置 MinIO MCP 的工作区桶（可选）：工具只能读写这一个桶。
# MINIO_MCP_BUCKET=assistant-workspace
# 默认不允许助手经 MCP 删除/移动对象；确有需求再显式放开。
# MINIO_MCP_ALLOW_DELETE=false

# 插件社区 stdio MCP（可选，默认关闭）：允许在后端容器内以子进程运行 MCP
# 命令，等同开放容器内命令执行，仅在理解风险后开启；镜像已内置 node/npx
# 与 uvx，命令必须进入白名单（逗号分隔，按可执行文件名匹配）。
# SUPER_ASSISTANT_MCP_STDIO_ENABLED=false
# SUPER_ASSISTANT_MCP_STDIO_ALLOWED_COMMANDS=npx,uvx

# 平台运行健康度（API 性能监控，系统设置 → 运行监控，仅 admin 可见）。
# 默认开启；出问题时 API_PERF_ENABLED=false 可整体关闭（零请求路径开销）。
API_PERF_ENABLED=true
# 慢接口判定阈值（毫秒）；超过阈值的请求即时单条落库并附带分层耗时分解。
API_PERF_SLOW_THRESHOLD_MS=1000
# 分钟聚合批量落库周期（秒）。
API_PERF_FLUSH_INTERVAL_SECONDS=30
# 慢请求明细保留天数（默认 7 天）。
API_PERF_SLOW_RETENTION_DAYS=7
# 分钟聚合保留天数（默认 30 天）。
API_PERF_AGG_RETENTION_DAYS=30
