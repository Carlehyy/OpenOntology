# 本地开发模板；生产第三方依赖当前由仓库受控的 deploy/production.dependencies.env
# 提供（受控临时例外，完整清单与迁移计划见 docs/operations/configuration.md）。
# 服务器首次部署会生成并持久化应用运行密钥；不要盲目轮换可能参与数据加密的密钥。
ENVIRONMENT=development
# app.* 应用日志级别（main.py 兜底 stderr handler）：DEBUG/INFO/WARNING/ERROR/CRITICAL。
# 生产默认 INFO（含世界模型发布/调用审计）；需要降噪时覆盖为 WARNING。
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql://ontoprompt:ontoprompt@db:5432/ontoprompt
# 集成数据集 dbx 元数据通道（生产部署用；非生产可选）。
# - URL 与 PASSWORD 均为空时，deploy-prod.sh 生成独立密码并连接内置
#   http://dbx:4224 服务；该服务不发布宿主端口。
# - URL 与 PASSWORD 同时显式填写时原样保留（可接外部 dbx）；只填一项会
#   fail closed，不会回退内置服务。
# - COMMIT 必须保持固定版本 pin，不得填写浮动 tag 或真实密钥。
INTEGRATED_DBX_URL=
INTEGRATED_DBX_PASSWORD=
INTEGRATED_DBX_COMMIT=0137e0cbc8b663da5a17ec424c6d47e4e5570ead
# Redis is always authenticated; the password is a local-development default.
# Production deployment replaces it with a generated server-side secret.
REDIS_PASSWORD=ontopromptredis123
REDIS_URL=redis://:ontopromptredis123@redis:6379/0
# 任务池读接口缓存（fail-open，可关闭；键落 db 1）
PIPELINE_TASK_CACHE_ENABLED=true
PIPELINE_TASK_LIST_CACHE_TTL_SECONDS=4
PIPELINE_TASK_STATS_CACHE_TTL_SECONDS=5
PIPELINE_TASK_OPTIONS_CACHE_TTL_SECONDS=30
# 本体详情页读接口缓存（fail-open，可关闭；键落 db 1）
# 覆盖：详情头 / 总览驾驶舱 / 待审批队列三个高频读接口；写路径自动失效。
ONTOLOGY_DETAIL_CACHE_ENABLED=true
ONTOLOGY_DETAIL_CACHE_TTL_SECONDS=60
ONTOLOGY_OVERVIEW_CACHE_TTL_SECONDS=20
ONTOLOGY_PENDING_CACHE_TTL_SECONDS=15
# ── 数据流水线读接口缓存（fail-open 加速层，键落 Redis db 1）──
# 关闭后全部直查；Redis 故障时自动降级直查，不影响主流程。
PIPELINE_READ_CACHE_ENABLED=true

SECRET_KEY=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=
# Fresh server bootstrap generates an independent Fernet ENCRYPTION_KEY. For an
# existing installation where this is empty, deploy-prod.sh first pins the old
# SECRET_KEY-derived key and only then rotates an example SECRET_KEY. Never
# replace both values manually: that makes persisted credentials unreadable.
# Empty CORS means same-origin only. Use comma-separated exact origins if needed.
CORS_ALLOWED_ORIGINS=
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=admin123
UPLOADS_DIR=/uploads
# 超级助手 Skill 默认保存到 <UPLOADS_DIR>/super-assistant/skills/<user>/<skill-id>。
SUPER_ASSISTANT_SKILL_ROOT=
# 公网 MCP 无需白名单；生产环境会自动拒绝环回、内网和链路本地地址。
# stdio 会在后端容器内启动进程，默认关闭；启用后仍需显式列出可执行 command。
SUPER_ASSISTANT_MCP_STDIO_ENABLED=false
SUPER_ASSISTANT_MCP_STDIO_ALLOWED_COMMANDS=
# Credential-bearing MCP/Remote Agent/Multica endpoints require HTTPS in
# production; development/test continue to accept local HTTP fixtures.
SUPER_ASSISTANT_EXTERNAL_HTTPS_REQUIRED=true
# 超级助手自我进化（对标 small-rust-hermes）：对话后自动做 micro 反思并产出
# 记忆/技能候选，低于置信度阈值或存在冲突的候选进入「待审批」人工确认。
# 反思任务经 NATS JetStream 派发（复用流水线 executor 进程消费）；未配置
# NATS_URL 时降级为 Web 进程内联执行——这是全平台唯一的无 NATS 降级例外，
# 流水线等其余派发保持 fail-closed。
SUPER_ASSISTANT_REFLECT_ENABLED=true
SUPER_ASSISTANT_REFLECT_INTERVAL=3
SUPER_ASSISTANT_AUTO_ACCEPT_MIN_CONFIDENCE=medium
# 工具权限：逗号分隔的工具名 glob（如 mcp__minio__delete_*,web_*），deny 优先。
SUPER_ASSISTANT_TOOL_ALLOW=
SUPER_ASSISTANT_TOOL_DENY=
# 联网工具：web_fetch 默认开启（SSRF 校验同 MCP）；web_search 需配置后端与密钥。
SUPER_ASSISTANT_WEB_FETCH_ENABLED=true
SUPER_ASSISTANT_WEB_SEARCH_BACKEND=
SUPER_ASSISTANT_WEB_SEARCH_TAVILY_API_KEY=
SUPER_ASSISTANT_WEB_SEARCH_BRAVE_API_KEY=
# Anthropic prompt caching（DeepSeek 等 anthropic 兼容端点不支持时需关闭）。
SUPER_ASSISTANT_PROMPT_CACHE_ENABLED=true
# 自主模式单条消息的最大工具迭代轮次（仅 agent_mode=true 时生效）。
SUPER_ASSISTANT_AGENT_MAX_ITERATIONS=50
# 超级助手：会话附件根目录，留空解析为 <UPLOADS_DIR>/super-assistant-sessions。
SUPER_ASSISTANT_WORKSPACE_ROOT=
# 超级助手：记忆宫殿（用户级文件库）根目录，留空解析为 <UPLOADS_DIR>/super-assistant-palace。
SUPER_ASSISTANT_PALACE_WORKSPACE_ROOT=
# 记忆宫殿配额与保护：单用户文件数 / 总存储(MB) / 在途抽取数 / 每小时抽取次数 / 单次 ZIP 导入文件数。
# 文件夹同步上线时上调文件数/存储/每小时默认值（原 500/2048/60）；在途与并发是抽取成本护栏。
SUPER_ASSISTANT_PALACE_MAX_FILES_PER_USER=2000
SUPER_ASSISTANT_PALACE_MAX_TOTAL_MB=10240
SUPER_ASSISTANT_PALACE_MAX_IN_FLIGHT=20
SUPER_ASSISTANT_PALACE_MAX_BUILDS_PER_HOUR=300
SUPER_ASSISTANT_PALACE_BATCH_MAX_FILES=100
# 记忆宫殿：图谱抽取并发（进程级）与每日聚类合并定时任务开关。
SUPER_ASSISTANT_PALACE_EXTRACT_CONCURRENCY=1
SUPER_ASSISTANT_PALACE_CONSOLIDATE_ENABLED=true
# 数据管家：会话文件根目录与独立浏览器 CDP 地址。CDP 是启动时必需
# 配置；只填写 HTTP(S) 服务根地址，不要附加 /json/version、查询参数或认证信息。
# 生产 Compose 固定使用随栈启动的 browser 服务。
STEWARD_WORKSPACE_ROOT=
STEWARD_BROWSER_CDP_URL=http://browser:9222
STEWARD_BROWSER_TIMEOUT_SECONDS=30
STEWARD_BROWSER_MAX_CAPTURES=300
STEWARD_BROWSER_FRAME_INTERVAL_MS=50
# WebSocket 被终端或代理拦截时，实时画面自动改走 HTTPS 轮询。
STEWARD_BROWSER_HTTP_LEASE_SECONDS=30
STEWARD_BROWSER_HTTP_FRAME_INTERVAL_MS=500
STEWARD_BROWSER_MAX_SESSIONS=8
STEWARD_BROWSER_MAX_SESSIONS_PER_USER=3
STEWARD_BROWSER_IDLE_TIMEOUT_SECONDS=900
STEWARD_BROWSER_REAPER_INTERVAL_SECONDS=30
# 私网浏览器目标仅允许在隔离的 development/test 环境显式启用；生产禁止。
STEWARD_BROWSER_ALLOW_PRIVATE_NETWORKS=false
STEWARD_PROXY_BASE_URL=http://backend:8000/api-hub/proxy
# n8n 是启动时必需的外部服务。复制本模板后必须填写一个可访问的 API
# 地址和 API Key；留空时后端会拒绝启动。
N8N_API_URL=
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30
# Python 脚本流水线的执行网关（Jupyter Kernel Gateway，可选）。Compose 部署
# 固定指向随栈启动的 python_kernel_gateway 服务；该服务以独立内核执行用户
# 脚本，不携带任何平台凭据环境变量。留空时脚本执行/保存返回明确错误。
PYTHON_KERNEL_GATEWAY_URL=http://python_kernel_gateway:8088
PYTHON_KERNEL_GATEWAY_AUTH_TOKEN=change-me-python-gateway-token
PYTHON_SCRIPT_TIMEOUT_SECONDS=120
# n8n 必须能访问此地址。生产部署脚本会在该值仍为默认值时，根据 HEALTH_URL
# 自动改成平台公网地址；显式配置的 HTTPS 地址永远不会被覆盖。
PIPELINE_FILE_GATEWAY_BASE_URL=http://backend:8000/api/v2/file-transfer
# 浏览器公网入口与 n8n 网关相互独立：APP 用于生成登录后继续下载的 Hash 深链，
# API 用于生成无需登录的匿名下载接口。两者都必须能从其他电脑的浏览器访问，
# 且只填写 HTTP(S) origin（不要包含路径、账号、查询参数或 # 片段）。
PIPELINE_FILE_PUBLIC_APP_BASE_URL=http://localhost:5173
PIPELINE_FILE_PUBLIC_API_BASE_URL=http://localhost:8000
# 可选：容器内 OfficeCLI 可执行文件的绝对路径。留空时核心会话文件空间仍可用，
# 但探索 Agent 不会获得 docx/xlsx/pptx 的结构化编辑工具。
EXPLORATION_OFFICECLI_PATH=
# 仅用于读取和迁移历史 local:// 对象；新写入始终要求 MinIO 可用。
# 生产 Compose 固定到共享持久卷 /uploads/object-storage。
STORAGE_LOCAL_DIR=storage
ALLOW_PUBLIC_REGISTRATION=true
PIPELINE_MAX_IN_MEMORY_ROWS=500000

# ===== WeKnora 共享知识库（官方 v0.9.0）=====
# 常规五服务：app / UI / docreader / ParadeDB / Redis。图谱检索默认关闭
# （NEO4J_ENABLE 不设置），不运行 WeKnora 专属 Neo4j；平台 Neo4j 与本栈无关。
# 生产正式 app 始终关闭注册。首次部署由 deploy-prod.sh 启动一次性的
# weknora-app-init（同镜像、同 DB，仅内网、无宿主端口）注册管理员账号，
# 随后删除 init 容器并启动正式 weknora-app（启动钩子把该邮箱提升为
# system admin）；bootstrap --verify 只登录确认管理员、通过官方设置 API
# 持久化 invite_only 并确认注册已关闭。模型/KB/MCP 端点在原生 Web UI 手工
# 配置，不是部署输入；backend 只读取正式 app 内网地址。
WEKNORA_BASE_URL=http://weknora-app:8080
# 公网原生 Web 地址。留空时 deploy-prod.sh 按 PUBLIC_TLS_IP + WEKNORA_HTTPS_PORT
# 推导；反向代理/域名部署时填真实绝对 origin（不带路径）。
WEKNORA_WEB_URL=
WEKNORA_HTTP_PORT=8089
WEKNORA_HTTPS_PORT=8444
# 仅本地开发：WeKnora app 的 loopback 直连端口，供宿主机源码后端/配置中心
# 使用 MCP 与 /api；不发布到公网，公网 gateway 仍只代理 UI 且 /mcp 404。
WEKNORA_APP_LOOPBACK_PORT=18080
WEKNORA_DEFAULT_LOCALE=zh-CN
WEKNORA_MAX_FILE_SIZE_MB=50
WEKNORA_TIMEOUT_SECONDS=15
# 管理员账号只用于 bootstrap/verify；密码由部署脚本生成并持久化，不从旧数据库逆取。
WEKNORA_ADMIN_USER=
WEKNORA_ADMIN_EMAIL=admin@weknora.local
WEKNORA_ADMIN_PASSWORD=
# 独立数据库/缓存/签名凭据；部署脚本只在缺失或示例值时生成一次。
# SYSTEM_AES_KEY 必须恰为 32 个 ASCII 字节；JWT/签名密钥跨部署稳定。
WEKNORA_DB_NAME=weknora
WEKNORA_DB_USER=weknora
WEKNORA_DB_PASSWORD=
WEKNORA_REDIS_PASSWORD=
WEKNORA_JWT_SECRET=
WEKNORA_SYSTEM_AES_KEY=
WEKNORA_SYSTEM_SIGNING_KEY=
# 官方 WeKnora v0.9.0 镜像（app/ui/docreader + ParadeDB + Redis）。生产部署
# 严格要求 @sha256 digest，未钉扎时 deploy-prod.sh 会 fail closed。
WEKNORA_APP_IMAGE=wechatopenai/weknora-app:v0.9.0@sha256:25b20959b7456f7842ef55ed4feff3694dbd0c6f8af4117c1fb3c5dec6bdf14d
WEKNORA_UI_IMAGE=wechatopenai/weknora-ui:v0.9.0@sha256:df26705d866997db07f3da78dabedc4f594b383566a3996810c166a5c6bee393
WEKNORA_DOCREADER_IMAGE=wechatopenai/weknora-docreader:v0.9.0@sha256:8c71ec3cc2e291829c3938d2c7dc5f921c1d10551c8774bf844c83bc4aa3cb84
WEKNORA_POSTGRES_IMAGE=paradedb/paradedb:v0.25.11-pg17@sha256:78d65750f0f88a56548526201bcab9910f83b90fe929cdbf979890f3f80b0f95
WEKNORA_REDIS_IMAGE=redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99

# ===== Hindsight 长期记忆（可选，官方 1.2.0）=====
# 可选特性：默认关闭（HINDSIGHT_ENABLED 缺省/false）。启用方式——
#   本地：docker compose --profile hindsight up -d（或在此写 COMPOSE_PROFILES=hindsight）
#   生产：HINDSIGHT_ENABLED=true 后运行 deploy/deploy-prod.sh
# 服务故障只降级记忆特性，聊天与全局 readiness 不受影响；无静默回退旧实现。
# API/管理 UI 仅 compose 内网 + loopback 端口，不暴露公网。
HINDSIGHT_ENABLED=false
HINDSIGHT_BASE_URL=http://hindsight:8888
HINDSIGHT_TIMEOUT_SECONDS=2
HINDSIGHT_NAMESPACE=openontology
# 可选：管理员专用的 Hindsight 原生 Web 入口（绝对 http(s) 根地址，默认空=不启用）。
# 非密钥：服务器 .env 原样保存，仅 backend 显式映射并使用（其余 env_file 服务
# 可能继承该值但不使用）。本地即 loopback 管理页 http://127.0.0.1:19999（写
# localhost 也按原样保留，不做改写）；生产须待外部防护就位后另行填写，链接
# 不新增任何鉴权/代理/SSO，URL 内不带 tenant/API key。
HINDSIGHT_WEB_URL=
# backend → Hindsight 的 Bearer 凭据（镜像内 ApiKeyTenantExtension 强校验）。
HINDSIGHT_API_KEY=
# Hindsight → 平台内部记忆 LLM 代理的 service token（与容器内
# HINDSIGHT_API_LLM_API_KEY 同值）；不是真实模型 key。记忆模型别名固定
# oo-memory-default（Hindsight 1.2.0 禁止 bank 级 llm_model 覆盖，不可自定义）；
# 真实模型由平台记忆网关在「唯一 enabled 且 model_config_id 非空」的用户
# 记忆 setting 中解析，0 条或多条均返回 503（单用户服务级选择）。
HINDSIGHT_SERVICE_TOKEN=
# 专用 DB（独立于平台 PG16，带 pgvector 扩展）。
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_PASSWORD=
# 仅本地开发：API 与管理 UI 的 loopback 直连端口（127.0.0.1）。
HINDSIGHT_LOOPBACK_PORT=18888
HINDSIGHT_UI_LOOPBACK_PORT=19999
# 官方镜像 digest 钉扎（生产启用时 deploy-prod.sh 校验 @sha256）。
# pgvector pg17 digest 为多架构 index（amd64+arm64 清单已经公共镜像源 OCI
# 元数据核验，arm64 本机 Docker Hub 实拉成功）；维护环境 docker.io 直连不可达，
# amd64 实拉与官方重取当前 tag 头（sha256:7d0a4146…）待网络恢复后完成，
# 拉取失败时重取覆盖，禁止退回浮动 tag。
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.2.0@sha256:19d0c08f3df79acac29384826419a1ca158129e81ec527cdcbd8c97ff4ef76da
HINDSIGHT_POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f

# Every image below is pinned to an immutable @sha256 digest so fresh
# installs and the strict digest validation pass out of the box. To upgrade a
# component, resolve the new digest and replace the reference deliberately.
POSTGRES_IMAGE=postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
REDIS_IMAGE=redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
NEO4J_IMAGE=neo4j:5-community@sha256:362542416de6c09a971484d1893878016cc3b5cdec166e54b1c824a220ecd6b9
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
BROWSER_IMAGE=chromedp/headless-shell@sha256:2d349b544a1ea6b5b5fd7c0fe99215ff662339c57407ee2e8c0a11af93516b04
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
NODE_BASE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
NGINX_BASE_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
# Production deploys require this to remain enabled.
STRICT_IMAGE_DIGESTS=1

# API Hub / 接口代理（已登记接口可调用任意 HTTP/HTTPS 目标）
API_HUB_DATA_DIR=
API_HUB_HTTP_TIMEOUT=30
API_HUB_MAX_RUNS_PER_INTERFACE=20
# 默认拒绝 loopback、链路本地、保留网段和 RFC1918 私网目标；仅对确需访问的
# 内网服务按精确主机名/IP 加白名单（逗号分隔），不要使用宽泛通配符。
API_HUB_OUTBOUND_BLOCK_PRIVATE_NETWORKS=true
API_HUB_OUTBOUND_TRUSTED_HOSTS=
# 接口重定向次数上限；每次重定向仍会校验目标必须是合法的 HTTP/HTTPS URL。
API_HUB_OUTBOUND_MAX_REDIRECTS=5
# 私有 CA 场景填写 CA bundle 路径；留空仍会校验系统信任链，不能关闭 TLS 校验。
API_HUB_TLS_CA_BUNDLE=
# 本体动作 Webhook 与 API Hub 共用上述出站安全策略；以下限制控制单次执行预算。
FORMAL_ACTION_WEBHOOK_TIMEOUT_SECONDS=15
FORMAL_ACTION_WEBHOOK_MAX_ATTEMPTS=2
FORMAL_ACTION_WEBHOOK_MAX_BODY_BYTES=1000000
# 令牌留空时对应 MCP 入口保持禁用（503），令牌只保存在服务端与调用方凭据库中。
API_HUB_MCP_TOKEN=
API_HUB_SYSTEM_MCP_TOKEN=
API_HUB_MCP_SERVER_NAME=api-hub
API_HUB_MCP_MAX_BODY_CHARS=20000
# 生产域名示例：api.example.com、https://api.example.com
API_HUB_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
API_HUB_MCP_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*
# 普通 HTTP 发布入口与调用方鉴权。公开接口形如 /proxy/<公开路径>，
# 调用方在 X-API-Hub-Key 中传入平台创建的独立密钥。
API_HUB_PROXY_PATH=/proxy
API_HUB_PROXY_KEY_HEADER=X-API-Hub-Key
API_HUB_PROXY_MAX_REQUEST_BYTES=10485760

# v2 — Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontoprompt123

# v2 — MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# 超级助手内置 MinIO MCP 的工作区桶（可选）：工具只能读写这一个桶。
# MINIO_MCP_BUCKET=assistant-workspace
# 默认不允许助手经 MCP 删除/移动对象；确有需求再显式放开。
# MINIO_MCP_ALLOW_DELETE=false

# 插件社区 stdio MCP（可选，默认关闭）：允许在后端容器内以子进程运行 MCP
# 命令，等同开放容器内命令执行，仅在理解风险后开启；镜像已内置 node/npx
# 与 uvx，命令必须进入白名单（逗号分隔，按可执行文件名匹配）。
# SUPER_ASSISTANT_MCP_STDIO_ENABLED=false
# SUPER_ASSISTANT_MCP_STDIO_ALLOWED_COMMANDS=npx,uvx

# 平台运行健康度（API 性能监控，系统设置 → 运行监控，仅 admin 可见）。
# 默认开启；出问题时 API_PERF_ENABLED=false 可整体关闭（零请求路径开销）。
API_PERF_ENABLED=true
# 慢接口判定阈值（毫秒）；超过阈值的请求即时单条落库并附带分层耗时分解。
API_PERF_SLOW_THRESHOLD_MS=1000
# 分钟聚合批量落库周期（秒）。
API_PERF_FLUSH_INTERVAL_SECONDS=30
# 慢请求明细保留天数（默认 7 天）。
API_PERF_SLOW_RETENTION_DAYS=7
# 分钟聚合保留天数（默认 30 天）。
API_PERF_AGG_RETENTION_DAYS=30

# ===== HTTPS 入口（裸 IP 自签；语音听写等浏览器安全上下文能力需要）=====
# 自签证书由 frontend_ssl_init 一次性生成并持久化；浏览器首次访问
# https://<服务器IP>:8443 时手动信任一次即可。换服务器 IP 时覆盖 PUBLIC_TLS_IP
# 并删除 frontend_ssl_certs 卷让证书重新生成。
# 同值的 PROD_PUBLIC_TLS_IP / PROD_PUBLIC_HTTPS_PORT 还会被 CI 烧进前端产物
# （deploy-nano-ontoprompt.yml），用于 http 页面自动跳转到 HTTPS 入口——
# 换 IP 时两处需同步更新。
PUBLIC_HTTPS_PORT=8443
PUBLIC_TLS_IP=64.83.14.139

# ===== 语音听写（超级助手，本地 SenseVoice 离线转写）=====
# 模型目录：容器部署由 compose 固定为 /voice-models（named volume），
# 宿主机预下载：docker compose exec backend python scripts/download_voice_model.py
# 本地开发留空 = backend/voice-models/。国内网络加 --mirror https://hf-mirror.com
VOICE_MODEL_DIR=
# 单次听写上限：音频时长（秒）与请求体大小（MB）
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_BODY_MB=8
# 并发转写上限：识别器常驻内存约 0.9GB/实例、每路解码再增数百 MB，
# 服务器内存紧张时保持 2 甚至降为 1；超限请求立即返回 429
VOICE_MAX_CONCURRENT=2
# 在线下载源（管理员在「语音」tab 一键下载时使用）；国内可配
# https://hf-mirror.com。也可改用 SSH 跑 scripts/download_voice_model.py
VOICE_MODEL_DOWNLOAD_BASE=https://huggingface.co
