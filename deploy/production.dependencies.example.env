# OpenOntology production dependency manifest template.
#
# This is the no-secret template for manual checks. The automatic deployment
# materializes these fields on the runner from individually scoped GitHub
# Repository Secrets/Variables via
# scripts/ci/materialize-production-dependencies.sh; the manifest itself is
# never tracked in Git.

ENVIRONMENT=production
PUBLIC_PORT=8088

# PostgreSQL
POSTGRES_DB=openontology
POSTGRES_USER=openontology
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis URL is the client authority. For the bundled Compose service use
# redis://:<16+-char-unescaped-password>@redis:6379/0; deployment derives
# requirepass from the same value. External Redis URLs remain unchanged.
REDIS_URL=

# Neo4j
NEO4J_URI=bolt+s://neo4j.example.com:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_AUTH=

# MinIO / S3-compatible object storage. MINIO_ENDPOINT is host:API-port only;
# the management console URL is not a runtime dependency setting.
MINIO_ENDPOINT=minio.example.com:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

# Externally managed n8n. Use the service root URL; historical /api/v1 values
# remain compatible. Both values are mandatory and probed before migrations or
# application services start.
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30
