# OpenOntology production dependency manifest template.
#
# This is the no-secret template for manual checks. The automatic deployment
# materializes these fields on the runner from individually scoped GitHub
# Repository Secrets/Variables via
# scripts/ci/materialize-production-dependencies.sh; the manifest itself is
# never tracked in Git.

ENVIRONMENT=production
PUBLIC_PORT=8088

# PostgreSQL
POSTGRES_DB=openontology
POSTGRES_USER=openontology
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis URL is the client authority. For the bundled Compose service use
# redis://:<16+-char-unescaped-password>@redis:6379/0; deployment derives
# requirepass from the same value. External Redis URLs remain unchanged.
REDIS_URL=

# Neo4j
NEO4J_URI=bolt+s://neo4j.example.com:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_AUTH=

# MinIO / S3-compatible object storage. MINIO_ENDPOINT is host:API-port only;
# the management console URL is not a runtime dependency setting.
MINIO_ENDPOINT=minio.example.com:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

# Externally managed n8n. Use the service root URL; historical /api/v1 values
# remain compatible. Both values are mandatory and probed before migrations or
# application services start.
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=30

# WeKnora v0.9.0 shared knowledge base. Chat and embedding models are
# mandatory deployment inputs; there is no fake default or automatic
# degradation. Admin/DB/Redis/Neo4j/JWT secrets are generated once on the
# server and persisted in .env, never supplied here.
WEKNORA_CHAT_BASE_URL=https://api.example.com/v1
WEKNORA_CHAT_API_KEY=
WEKNORA_CHAT_MODEL=
WEKNORA_EMBEDDING_BASE_URL=https://api.example.com/v1
WEKNORA_EMBEDDING_API_KEY=
WEKNORA_EMBEDDING_MODEL=
WEKNORA_EMBEDDING_DIMENSIONS=1024
# Optional: real public origin; deploy-prod.sh derives it from PUBLIC_TLS_IP
# and WEKNORA_HTTPS_PORT when omitted.
WEKNORA_WEB_URL=
# Optional admin identity; defaults to FIRST_ADMIN_USER and admin@weknora.local.
WEKNORA_ADMIN_USER=
WEKNORA_ADMIN_EMAIL=admin@weknora.local
# Optional official image pins. When set they must include @sha256; otherwise
# the deployment fails closed on the unverified tag example.
WEKNORA_APP_IMAGE=
WEKNORA_UI_IMAGE=
WEKNORA_DOCREADER_IMAGE=
WEKNORA_POSTGRES_IMAGE=
WEKNORA_REDIS_IMAGE=
WEKNORA_NEO4J_IMAGE=
